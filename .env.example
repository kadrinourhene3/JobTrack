# Public client configuration. Copy this file to .env and use the Dashboard Connect values.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the current sb_publishable_... key (the legacy anon key remains compatible).
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Never put service-role keys or AI provider secrets in Expo environment variables.
# AI_PROVIDER, OPENAI_API_KEY, and OPENAI_MODEL belong only in Supabase Edge Function secrets.
